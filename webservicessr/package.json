{
  "name": "webservicessr",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "greet": "echo 'Hola mundo'",
    "start": "NODE_ENV=production node ./bin/www",
    "dev": "DEBUG=webservicessr:* nodemon ./bin/www",
    "dev:vite": "vite",
    "dev:all": "concurrently \"npm run dev\" \"npm run dev:vite\"",
    "build": "vite build",
    "preview": "npm run build && npm start",
    "lint:back": "eslint \"app.js\" \"routes/**/*.js\" \"lib/**/*.js\"",
    "lint:fix": "eslint . --fix",
    "lint:front": "eslint \"src/**/*.js\"",
    "lint:all": "npm run lint:back && npm run lint:front"
  },
  "dependencies": {
    "cookie-parser": "~1.4.4",
    "debug": "~2.6.9",
    "express": "~4.16.1",
    "hbs": "~4.0.4",
    "http-errors": "~1.6.3",
    "morgan": "~1.9.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "concurrently": "^10.0.6",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "nodemon": "^3.1.14",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.4"
  },
  "imports": {
    "#routes/*": "./routes/*",
    "#lib/*": "./lib/*"
  }
}
